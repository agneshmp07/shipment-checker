<?xml version="1.0" encoding="utf-8"?>
<!-- Oops-Proof mark: the "o" of Oops with the orange dot of the mistake we catch
     (same as assets/mark.svg), inside the 66dp safe zone. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:translateX="16"
        android:translateY="16"
        android:scaleX="1.2"
        android:scaleY="1.2">
        <!-- the "o" -->
        <path
            android:strokeColor="#F5F0E6"
            android:strokeWidth="7"
            android:fillColor="#00000000"
            android:pathData="M30,20 A14,14 0 1,1 29.99,20 Z" />
        <!-- the oops dot -->
        <path
            android:fillColor="#F2690F"
            android:pathData="M45.5,12 A6.5,6.5 0 1,1 45.49,12 Z" />
    </group>
</vector>

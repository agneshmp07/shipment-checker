# Copy to .streamlit/secrets.toml (never commit the real file), or paste into the
# Secrets box on Streamlit Community Cloud. Set ONE provider; with none, the app still
# works and chat uses the built-in parser.

# Option A - Anthropic (preferred if both are set)
# ANTHROPIC_API_KEY = "sk-ant-..."
# ANTHROPIC_MODEL = "claude-opus-5-5"      # optional

# Option B - Google Gemini
# GEMINI_API_KEY = "AIza..."
# GEMINI_MODEL = "gemini-flash-latest"     # optional
